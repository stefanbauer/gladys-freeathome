# Credentials for THIS integration's own Gladys developer registration only.
# Prefer npm run dev:login, which creates .env safely. Manual setup: use the
# exact issued selector/token with mode 600. Never use another integration's.
GLADYS_HOST_API_URL=http://localhost:1443
GLADYS_INTEGRATION_SELECTOR=ext-dev-freehome
GLADYS_INTEGRATION_TOKEN=
LOG_LEVEL=info

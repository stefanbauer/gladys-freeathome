# Optional native SDK debugging only; NOT needed for the Docker installation.
# Gladys injects these values into its container automatically. Never run a
# second SDK process with the same identity. Protect any local .env with mode 600.
# The dev:* Docker helpers use their own admin session, not this file.
GLADYS_HOST_API_URL=http://localhost:1443
GLADYS_INTEGRATION_SELECTOR=
GLADYS_INTEGRATION_TOKEN=
LOG_LEVEL=info
